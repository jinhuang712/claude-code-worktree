{
  "description": "Record which files each Claude session edits, so /wt:worktree can move only this session's changes.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/wt.py\" track",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
